{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDP USB Vault",
  "version": "0.4.0",
  "identifier": "com.edp.usbvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EDP USB Vault",
        "width": 980,
        "height": 680,
        "minWidth": 780,
        "minHeight": 560,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/usbcore": "usbcore"
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchDaemons/com.edp.usbvault.daemon.plist": "./embedded/com.edp.usbvault.daemon.plist"
      }
    }
  }
}
