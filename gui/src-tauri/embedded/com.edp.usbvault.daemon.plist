<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edp.usbvault.daemon.v2</string>
  <key>BundleProgram</key>
  <string>Contents/Resources/usbcore</string>
  <key>ProgramArguments</key>
  <array>
    <string>Contents/Resources/usbcore</string>
    <string>daemon</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 加密桥位于 Finder 文件 I/O 的同步热路径，必须按交互式请求调度；
       daemon 空闲时不运行加密任务，因此不会持续占用前台 CPU。 -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
