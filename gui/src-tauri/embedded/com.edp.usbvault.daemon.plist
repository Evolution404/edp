<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edp.usbvault.daemon.v2</string>
  <key>BundleProgram</key>
  <string>Contents/Resources/usbcore</string>
  <key>ProgramArguments</key>
  <array>
    <string>Contents/Resources/usbcore</string>
    <string>daemon</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 加密桥是前台文件 I/O 的热路径，不能被 launchd 以 Background CPU/QoS
       节流；Standard 仍保持普通系统优先级，不抢占交互式进程。 -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
