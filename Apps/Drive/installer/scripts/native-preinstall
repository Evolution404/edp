#!/bin/bash
set -euo pipefail

SERVICE_LABEL="com.edp.drive.service"
DRIVE_UI_EXECUTABLE="/Applications/EDP Drive.app/Contents/MacOS/EDP Drive"
# macOS keeps `ucomm` even when an exiting process has lost its original argv.
# These are the kernel-truncated names for the product service/transport.
SERVICE_UCOMM="edp-drive-servic"
TRANSPORT_UCOMM="edp-mfmount-loca"

pids_for_ucomm() {
  local process_name="$1"
  /bin/ps -axo pid=,ucomm= \
    | /usr/bin/awk -v process_name="${process_name}" '$2 == process_name { print $1 }'
}

drive_ui_pids() {
  /bin/ps -axo pid=,command= \
    | /usr/bin/awk -v expected="${DRIVE_UI_EXECUTABLE}" '
        {
          pid=$1
          sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "")
          if ($0 == expected) print pid
        }
      '
}

stop_running_drive_ui() {
  local pids
  pids="$(drive_ui_pids)"
  [[ -n "${pids}" ]] || return 0

  echo "EDP Drive upgrade stopping the currently running foreground UI before bundle replacement."
  /bin/kill -TERM ${pids} >/dev/null 2>&1 || true
  local i
  for ((i = 0; i < 50; i++)); do
    [[ -z "$(drive_ui_pids)" ]] && return 0
    /bin/sleep 0.1
  done

  pids="$(drive_ui_pids)"
  [[ -n "${pids}" ]] || return 0
  /bin/kill -KILL ${pids} >/dev/null 2>&1 || true
  for ((i = 0; i < 20; i++)); do
    [[ -z "$(drive_ui_pids)" ]] && return 0
    /bin/sleep 0.1
  done

  echo "EDP Drive upgrade cannot stop the existing foreground UI; refusing in-place bundle replacement." >&2
  exit 1
}

wait_for_ucomm_to_exit() {
  local process_name="$1"
  local attempts="$2"
  local i
  for ((i = 0; i < attempts; i++)); do
    if [[ -z "$(pids_for_ucomm "${process_name}")" ]]; then
      return 0
    fi
    /bin/sleep 0.1
  done
  return 1
}

recover_stale_console_fskit_agent() {
  # Only recover the exact no-mount stale-host state observed with macFUSE
  # Local. Never restart the user's FSKit agent while any FSKit filesystem is
  # still mounted, and never touch the root fskitd daemon.
  if /sbin/mount | /usr/bin/grep -Fq 'fskit'; then
    return 1
  fi

  local console_uid agent_pid agent_uid agent_command
  console_uid="$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || true)"
  [[ "${console_uid}" =~ ^[0-9]+$ && "${console_uid}" -gt 0 ]] || return 1

  agent_pid="$(/bin/ps -axo pid=,uid=,command= \
    | /usr/bin/awk -v uid="${console_uid}" '$2 == uid && $3 == "/usr/libexec/fskit_agent" { print $1; exit }')"
  [[ "${agent_pid}" =~ ^[0-9]+$ && "${agent_pid}" -gt 1 ]] || return 1

  agent_uid="$(/bin/ps -p "${agent_pid}" -o uid= 2>/dev/null | /usr/bin/xargs || true)"
  agent_command="$(/bin/ps -p "${agent_pid}" -o command= 2>/dev/null | /usr/bin/xargs || true)"
  [[ "${agent_uid}" == "${console_uid}" && "${agent_command}" == "/usr/libexec/fskit_agent" ]] || return 1

  echo "EDP Drive upgrade restarting stale console-user fskit_agent (${agent_pid})."
  /bin/kill -KILL "${agent_pid}" >/dev/null 2>&1 || return 1
  local i
  for ((i = 0; i < 100; i++)); do
    if ! /bin/kill -0 "${agent_pid}" >/dev/null 2>&1; then
      return 0
    fi
    /bin/sleep 0.1
  done
  return 1
}

stop_unmounted_processes() {
  local process_name="$1"
  local description="$2"
  local pids

  pids="$(pids_for_ucomm "${process_name}")"
  [[ -n "${pids}" ]] || return 0

  /bin/kill -TERM ${pids} >/dev/null 2>&1 || true
  if wait_for_ucomm_to_exit "${process_name}" 100; then
    return 0
  fi

  pids="$(pids_for_ucomm "${process_name}")"
  [[ -n "${pids}" ]] || return 0
  /bin/kill -KILL ${pids} >/dev/null 2>&1 || true
  if wait_for_ucomm_to_exit "${process_name}" 50; then
    return 0
  fi

  if [[ "${process_name}" == "${TRANSPORT_UCOMM}" ]] \
    && recover_stale_console_fskit_agent \
    && wait_for_ucomm_to_exit "${process_name}" 100; then
    return 0
  fi

  echo "EDP Drive upgrade cannot stop stale ${description}; restart macOS and run the installer again." >&2
  exit 1
}

SESSION_STATE="/var/db/com.edp.drive/sessions.json"

session_value() {
  local index="$1"
  local key="$2"
  /usr/bin/plutil -extract "${index}.${key}" raw -o - "${SESSION_STATE}" 2>/dev/null || true
}

is_session_index() {
  local index="$1"
  /usr/bin/plutil -type "${index}" "${SESSION_STATE}" >/dev/null 2>&1
}

refuse_active_user_filesystems() {
  if [[ ! -f "${SESSION_STATE}" ]]; then
    if /sbin/mount | /usr/bin/grep -Fq ' on /Volumes/.edp-block-'; then
      echo "EDP Drive upgrade refused because hidden EDP sessions exist without recoverable session state. Restart macOS and retry." >&2
      exit 1
    fi
    return 0
  fi

  local index=0
  local bridge mountpoint exposed
  while is_session_index "${index}"; do
    bridge="$(session_value "${index}" bridgeMount)"
    mountpoint="$(session_value "${index}" mountpoint)"
    exposed="$(session_value "${index}" exposedBSD)"

    if [[ -n "${mountpoint}" ]] \
      && /sbin/mount | /usr/bin/grep -Fq " on ${mountpoint} ("; then
      echo "EDP Drive upgrade refused because an EDP user filesystem is still mounted at ${mountpoint}. Safely eject it first." >&2
      exit 1
    fi
    if [[ -n "${exposed}" ]]; then
      if [[ ! "${exposed}" =~ ^disk[0-9]+$ ]]; then
        echo "EDP Drive upgrade refused because persisted exposed BSD state is invalid." >&2
        exit 1
      fi
      if /sbin/mount | /usr/bin/grep -Eq "^/dev/${exposed}[^[:space:]]* on "; then
        echo "EDP Drive upgrade refused because published EDP media ${exposed} still has a mounted filesystem." >&2
        exit 1
      fi
    fi
    if [[ -n "${bridge}" && ! "${bridge}" == /Volumes/.edp-block-* ]]; then
      echo "EDP Drive upgrade refused because persisted bridge state is outside the EDP namespace." >&2
      exit 1
    fi
    ((index += 1))
  done
}

hdi_value() {
  local plist="$1"
  local index="$2"
  local key="$3"
  /usr/bin/plutil -extract "images.${index}.${key}" raw -o - "${plist}" 2>/dev/null || true
}

legacy_orphan_pid_for_backing() {
  local plist="$1"
  local backing="$2"
  local image_index=0
  local image_path owner_uid diskimages2 autodiskmount encrypted owner_mode entities pid

  while /usr/bin/plutil -type "images.${image_index}" "${plist}" >/dev/null 2>&1; do
    image_path="$(hdi_value "${plist}" "${image_index}" image-path)"
    if [[ "${image_path}" == "${backing}" ]]; then
      owner_uid="$(hdi_value "${plist}" "${image_index}" owner-uid)"
      diskimages2="$(hdi_value "${plist}" "${image_index}" diskimages2)"
      autodiskmount="$(hdi_value "${plist}" "${image_index}" autodiskmount)"
      encrypted="$(hdi_value "${plist}" "${image_index}" image-encrypted)"
      owner_mode="$(hdi_value "${plist}" "${image_index}" owner-mode)"
      entities="$(/usr/bin/plutil -extract "images.${image_index}.system-entities" json -o - "${plist}" 2>/dev/null | /usr/bin/tr -d '[:space:]' || true)"
      pid="$(hdi_value "${plist}" "${image_index}" hdid-pid)"
      if [[ "${owner_uid}" == "0" \
        && "${diskimages2}" == "true" \
        && "${autodiskmount}" == "false" \
        && "${encrypted}" == "false" \
        && "${owner_mode}" == "384" \
        && "${entities}" == "[]" \
        && "${pid}" =~ ^[0-9]+$ \
        && "${pid}" -gt 1 ]]; then
        printf '%s\n' "${pid}"
      fi
      return 0
    fi
    ((image_index += 1))
  done
  return 0
}

validate_diskimagesiod_pid() {
  local pid="$1"
  local owner command
  owner="$(/bin/ps -p "${pid}" -o user= 2>/dev/null | /usr/bin/xargs || true)"
  command="$(/bin/ps -p "${pid}" -o comm= 2>/dev/null | /usr/bin/xargs || true)"
  [[ "${owner}" == "_diskimagesiod" && "${command}" == "/usr/libexec/diskimagesiod" ]]
}

is_edp_storage_test_backing_path() {
  local path="$1"
  [[ "${path}" != *'/../'* && "${path}" != *'/..' ]] || return 1
  [[ "${path}" == /var/folders/*/*/T/edp-storage-e2e.*/mounts/*/volume.raw \
    || "${path}" == /private/var/folders/*/*/T/edp-storage-e2e.*/mounts/*/volume.raw ]]
}

test_orphan_pid_for_backing() {
  local plist="$1"
  local backing="$2"
  local console_uid="$3"
  local image_index=0
  local image_path owner_uid diskimages2 autodiskmount encrypted owner_mode entities pid bridge

  is_edp_storage_test_backing_path "${backing}" || return 0
  bridge="${backing%/volume.raw}"
  if /sbin/mount | /usr/bin/grep -Fq " on ${bridge} ("; then
    return 0
  fi

  while /usr/bin/plutil -type "images.${image_index}" "${plist}" >/dev/null 2>&1; do
    image_path="$(hdi_value "${plist}" "${image_index}" image-path)"
    if [[ "${image_path}" == "${backing}" ]]; then
      owner_uid="$(hdi_value "${plist}" "${image_index}" owner-uid)"
      diskimages2="$(hdi_value "${plist}" "${image_index}" diskimages2)"
      autodiskmount="$(hdi_value "${plist}" "${image_index}" autodiskmount)"
      encrypted="$(hdi_value "${plist}" "${image_index}" image-encrypted)"
      owner_mode="$(hdi_value "${plist}" "${image_index}" owner-mode)"
      entities="$(/usr/bin/plutil -extract "images.${image_index}.system-entities" json -o - "${plist}" 2>/dev/null | /usr/bin/tr -d '[:space:]' || true)"
      pid="$(hdi_value "${plist}" "${image_index}" hdid-pid)"
      if [[ "${owner_uid}" == "${console_uid}" \
        && "${diskimages2}" == "true" \
        && "${autodiskmount}" == "false" \
        && "${encrypted}" == "false" \
        && "${owner_mode}" == "384" \
        && "${entities}" == "[]" \
        && "${pid}" =~ ^[0-9]+$ \
        && "${pid}" -gt 1 ]]; then
        printf '%s\n' "${pid}"
      fi
      return 0
    fi
    ((image_index += 1))
  done
  return 0
}

recover_edp_storage_test_diskimages2_orphans() {
  local console_uid info image_index image_path pid refreshed_pid bridge
  console_uid="$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || true)"
  [[ "${console_uid}" =~ ^[0-9]+$ && "${console_uid}" -gt 0 ]] || return 0
  if /bin/ps -axo command= | /usr/bin/grep -F 'Apps/Drive/Tests/run-storage.sh' | /usr/bin/grep -v grep >/dev/null 2>&1; then
    echo "EDP Drive upgrade refused because a storage regression is still running." >&2
    exit 1
  fi

  info="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/edp-preinstall-test-hdi.XXXXXX")"
  trap '/bin/rm -f "'"${info}"'"' EXIT
  /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || return 0

  image_index=0
  while /usr/bin/plutil -type "images.${image_index}" "${info}" >/dev/null 2>&1; do
    image_path="$(hdi_value "${info}" "${image_index}" image-path)"
    if is_edp_storage_test_backing_path "${image_path}"; then
      bridge="${image_path%/volume.raw}"
      if /sbin/mount | /usr/bin/grep -Fq " on ${bridge} ("; then
        echo "EDP Drive upgrade refused because storage-test backing is still actively mounted: ${bridge}" >&2
        exit 1
      fi
      pid="$(test_orphan_pid_for_backing "${info}" "${image_path}" "${console_uid}")"
      if [[ -n "${pid}" ]] && validate_diskimagesiod_pid "${pid}"; then
        # Refresh immediately before signalling so a recycled PID/backing tuple
        # can never inherit authority from the earlier enumeration.
        /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
        refreshed_pid="$(test_orphan_pid_for_backing "${info}" "${image_path}" "${console_uid}")"
        if [[ "${refreshed_pid}" == "${pid}" ]] && validate_diskimagesiod_pid "${pid}"; then
          echo "EDP Drive upgrade recovering storage-test DiskImages2 orphan (${pid})."
          /bin/kill -TERM "${pid}" >/dev/null 2>&1 || true
          /bin/sleep 0.5
        fi

        /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
        refreshed_pid="$(test_orphan_pid_for_backing "${info}" "${image_path}" "${console_uid}")"
        if [[ "${refreshed_pid}" == "${pid}" ]] && validate_diskimagesiod_pid "${pid}"; then
          /bin/kill -KILL "${pid}" >/dev/null 2>&1 || true
          /bin/sleep 0.5
        fi

        /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
        refreshed_pid="$(test_orphan_pid_for_backing "${info}" "${image_path}" "${console_uid}")"
        if [[ -n "${refreshed_pid}" ]]; then
          echo "EDP Drive upgrade could not recover storage-test DiskImages2 orphan; restart macOS and retry." >&2
          exit 1
        fi
      fi
    fi
    ((image_index += 1))
  done
  /bin/rm -f "${info}"
  trap - EXIT
}

wait_for_device_to_disappear() {
  local bsd="$1"
  local attempts="$2"
  local i
  for ((i = 0; i < attempts; i++)); do
    [[ ! -e "/dev/${bsd}" ]] && return 0
    /bin/sleep 0.1
  done
  [[ ! -e "/dev/${bsd}" ]]
}

validate_diskimages_helper_pid() {
  local pid="$1"
  local owner command
  owner="$(/bin/ps -p "${pid}" -o user= 2>/dev/null | /usr/bin/xargs || true)"
  command="$(/bin/ps -p "${pid}" -o command= 2>/dev/null | /usr/bin/xargs || true)"
  [[ "${owner}" == "root" \
    && "${command}" == /System/Library/PrivateFrameworks/DiskImages.framework/Resources/diskimages-helper\ -uuid\ *\ -post-exec\ 4 ]]
}

is_uuid_dmg_path() {
  local path="$1"
  local base
  [[ "${path}" == /var/folders/zz/*/T/*.dmg || "${path}" == /private/var/folders/zz/*/T/*.dmg ]] || return 1
  base="${path##*/}"
  base="${base%.dmg}"
  [[ "${base}" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]
}

macfuse_scratch_pid_for_identity() {
  local plist="$1"
  local backing="$2"
  local expected_device="$3"
  local image_index=0 image_path owner_uid diskimages2 autodiskmount writable removable
  local blockcount blocksize entities_count device pid

  is_uuid_dmg_path "${backing}" || return 0
  [[ "${expected_device}" =~ ^/dev/disk[0-9]+$ ]] || return 0

  while /usr/bin/plutil -type "images.${image_index}" "${plist}" >/dev/null 2>&1; do
    image_path="$(hdi_value "${plist}" "${image_index}" image-path)"
    if [[ "${image_path}" == "${backing}" ]]; then
      owner_uid="$(hdi_value "${plist}" "${image_index}" owner-uid)"
      diskimages2="$(hdi_value "${plist}" "${image_index}" diskimages2)"
      autodiskmount="$(hdi_value "${plist}" "${image_index}" autodiskmount)"
      writable="$(hdi_value "${plist}" "${image_index}" writeable)"
      removable="$(hdi_value "${plist}" "${image_index}" removable)"
      blockcount="$(hdi_value "${plist}" "${image_index}" blockcount)"
      blocksize="$(hdi_value "${plist}" "${image_index}" blocksize)"
      pid="$(hdi_value "${plist}" "${image_index}" hdid-pid)"
      if /usr/bin/plutil -type "images.${image_index}.system-entities.0" "${plist}" >/dev/null 2>&1 \
        && ! /usr/bin/plutil -type "images.${image_index}.system-entities.1" "${plist}" >/dev/null 2>&1; then
        entities_count="1"
      else
        entities_count="0"
      fi
      device="$(/usr/bin/plutil -extract "images.${image_index}.system-entities.0.dev-entry" raw -o - "${plist}" 2>/dev/null || true)"
      if [[ "${owner_uid}" == "0" \
        && "${diskimages2}" == "false" \
        && "${autodiskmount}" == "false" \
        && "${writable}" == "true" \
        && "${removable}" == "true" \
        && "${blockcount}" == "8" \
        && "${blocksize}" == "512" \
        && "${entities_count}" == "1" \
        && "${device}" == "${expected_device}" \
        && "${pid}" =~ ^[0-9]+$ \
        && "${pid}" -gt 1 ]]; then
        printf '%s\n' "${pid}"
      fi
      return 0
    fi
    ((image_index += 1))
  done
  return 0
}

recover_macfuse_scratch_orphans() {
  local info
  info="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/edp-preinstall-scratch.XXXXXX")"
  trap '/bin/rm -f "'"${info}"'"' EXIT

  local image_index image_path device pid refreshed_pid
  while true; do
    /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || return 0
    image_index=0
    image_path=""
    device=""
    pid=""

    while /usr/bin/plutil -type "images.${image_index}" "${info}" >/dev/null 2>&1; do
      image_path="$(hdi_value "${info}" "${image_index}" image-path)"
      device="$(/usr/bin/plutil -extract "images.${image_index}.system-entities.0.dev-entry" raw -o - "${info}" 2>/dev/null || true)"
      pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
      if [[ -n "${pid}" ]]; then
        break
      fi
      image_path=""
      device=""
      pid=""
      ((image_index += 1))
    done

    [[ -n "${pid}" ]] || break

    # Re-enumerate immediately before every destructive action. The hdiutil
    # images array is mutable after a detach, so exact backing + device identity
    # is the only stable authority; array indices and historical diskN are not.
    /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
    refreshed_pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
    if [[ "${refreshed_pid}" != "${pid}" ]]; then
      continue
    fi

    # A live, exact diskimages-helper scratch can be detached independently of
    # unrelated FSKit filesystems. Do not block this safe direct-detach path just
    # because another volume (for example an external ExFAT disk) uses FSKit.
    # The only operation that can disturb unrelated FSKit volumes is recycling
    # fskit_agent; recover_stale_console_fskit_agent() already fail-closes when
    # any FSKit mount is active.
    if validate_diskimages_helper_pid "${pid}"; then
      echo "EDP Drive upgrade recovering macFUSE scratch orphan ${device} (${pid})."
      /usr/bin/hdiutil detach "${device}" -force >/dev/null 2>&1 || true

      /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
      refreshed_pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
      if [[ "${refreshed_pid}" == "${pid}" ]] && validate_diskimages_helper_pid "${pid}"; then
        /bin/kill -TERM "${pid}" >/dev/null 2>&1 || true
        /bin/sleep 0.2
      fi

      /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
      refreshed_pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
      if [[ "${refreshed_pid}" == "${pid}" ]] && validate_diskimages_helper_pid "${pid}"; then
        /bin/kill -KILL "${pid}" >/dev/null 2>&1 || true
        /bin/sleep 0.2
      fi
    else
      echo "EDP Drive upgrade found macFUSE scratch ${device} with stale helper record (${pid})."
    fi

    # macOS can keep the 4 KiB scratch IOMedia alive after diskimages-helper has
    # exited, leaving hdiutil's hdid-pid field stale. In the exact no-mount
    # state, recycle only the console user's fskit_agent and then re-prove the
    # same backing + device tuple. Never act on the recorded PID by itself.
    /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
    refreshed_pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
    if [[ -z "${refreshed_pid}" ]]; then
      continue
    fi
    if [[ "${refreshed_pid}" != "${pid}" ]]; then
      continue
    fi

    if ! validate_diskimages_helper_pid "${pid}"; then
      # Stale-helper recovery may recycle the console user's fskit_agent. That
      # helper performs its own global FSKit-mount guard and refuses the recycle
      # while any unrelated FSKit filesystem is active.
      if recover_stale_console_fskit_agent; then
        wait_for_device_to_disappear "${device#/dev/}" 100 || true
      fi
      /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
      refreshed_pid="$(macfuse_scratch_pid_for_identity "${info}" "${image_path}" "${device}")"
      if [[ -z "${refreshed_pid}" ]]; then
        continue
      fi
    fi

    echo "EDP Drive upgrade could not recover macFUSE scratch orphan ${device}; restart macOS and retry." >&2
    exit 1
  done
  /bin/rm -f "${info}"
  trap - EXIT
}

recover_legacy_root_diskimages2_orphans() {
  [[ -f "${SESSION_STATE}" ]] || return 0
  local info
  info="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/edp-preinstall-hdi.XXXXXX")"
  trap '/bin/rm -f "'"${info}"'"' EXIT
  /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || return 0

  local index=0
  local bridge exposed backing pid refreshed_pid
  while is_session_index "${index}"; do
    bridge="$(session_value "${index}" bridgeMount)"
    exposed="$(session_value "${index}" exposedBSD)"
    if [[ -n "${bridge}" && -n "${exposed}" && "${bridge}" == /Volumes/.edp-block-* && "${exposed}" =~ ^disk[0-9]+$ ]]; then
      backing="${bridge}/volume.raw"
      pid="$(legacy_orphan_pid_for_backing "${info}" "${backing}")"
      if [[ -n "${pid}" ]] && validate_diskimagesiod_pid "${pid}"; then
        echo "EDP Drive upgrade recovering legacy DiskImages2 orphan ${exposed} (${pid})."
        /bin/kill -TERM "${pid}" >/dev/null 2>&1 || true
        if ! wait_for_device_to_disappear "${exposed}" 20; then
          /usr/bin/hdiutil info -plist >"${info}" 2>/dev/null || true
          refreshed_pid="$(legacy_orphan_pid_for_backing "${info}" "${backing}")"
          if [[ "${refreshed_pid}" == "${pid}" ]] && validate_diskimagesiod_pid "${pid}"; then
            /bin/kill -KILL "${pid}" >/dev/null 2>&1 || true
          fi
          if ! wait_for_device_to_disappear "${exposed}" 20; then
            echo "EDP Drive upgrade could not recover legacy DiskImages2 orphan ${exposed}; restart macOS and retry." >&2
            exit 1
          fi
        fi
      fi
    fi
    ((index += 1))
  done
  /bin/rm -f "${info}"
  trap - EXIT
}

# Never replace the App bundle while an older foreground process is still
# executing from it. macOS code-signing validation correctly rejects that stale
# process after an in-place upgrade, which would otherwise leave menu-bar XPC
# controls unable to stop or manage the new privileged service.
stop_running_drive_ui

# Preserve filesystem durability: an upgrade may recover the known legacy
# root/no-IOMedia publication bug only after every user-visible filesystem has
# already been unmounted. Any active user filesystem remains a hard stop.
refuse_active_user_filesystems

# Remove the current launchd registration first. launchctl can report before a
# process has fully left the kernel, so verify both the job and exact processes.
/bin/launchctl bootout "system/${SERVICE_LABEL}" >/dev/null 2>&1 || true
for _ in {1..50}; do
  if ! /bin/launchctl print "system/${SERVICE_LABEL}" >/dev/null 2>&1; then
    break
  fi
  /bin/sleep 0.1
done
if /bin/launchctl print "system/${SERVICE_LABEL}" >/dev/null 2>&1; then
  echo "EDP Drive upgrade cannot remove the existing launchd job; restart macOS and run the installer again." >&2
  exit 1
fi

# The old root daemon can leave DiskImages2 publications without an IOMedia
# identity. Recover only those exact persisted orphans before stopping their
# now-unpublished macFUSE transports. Storage regression interruptions can leave
# the same owner-only shape under the hardware-free edp-storage-e2e namespace;
# revalidate its exact temp backing and console-user owner before signalling.
recover_legacy_root_diskimages2_orphans
recover_edp_storage_test_diskimages2_orphans

stop_unmounted_processes "${TRANSPORT_UCOMM}" "transport process"
stop_unmounted_processes "${SERVICE_UCOMM}" "service process"
recover_macfuse_scratch_orphans

if /sbin/mount | /usr/bin/grep -Fq ' on /Volumes/.edp-block-'; then
  echo "EDP Drive upgrade could not clear all hidden block transports; restart macOS and retry." >&2
  exit 1
fi

for LABEL in com.edp.usbvault.mountd com.edp.usbvault.mountd.v2; do
  /bin/launchctl bootout "system/${LABEL}" >/dev/null 2>&1 || true
done
/bin/rm -f \
  /Library/LaunchDaemons/com.edp.drive.service.plist \
  /Library/LaunchDaemons/com.edp.usbvault.mountd.plist \
  /Library/LaunchDaemons/com.edp.usbvault.mountd.v2.plist

OLD_ROOT="/Library/Application Support/EDP USB Vault"
OLD_CTL="${OLD_ROOT}/bin/edp-vaultctl"
if [[ -x "${OLD_CTL}" ]]; then
  "${OLD_CTL}" cleanup >/dev/null 2>&1 || true
fi
for RETIRED_RUNTIME in edp-readwrite-fuse edp-raw-sparse; do
  /bin/rm -f "${OLD_ROOT}/bin/${RETIRED_RUNTIME}"
done
/bin/rm -rf "${OLD_ROOT}"

OLD_APP="/Applications/EDP USB Vault.app"
OLD_RAW_ACCESS_APP="/Applications/EDP USB Vault Raw Access.app"
if [[ -f "${OLD_APP}/Contents/Info.plist" ]]; then
  OLD_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "${OLD_APP}/Contents/Info.plist" 2>/dev/null || true)"
  if [[ "${OLD_ID}" == "com.edp.usbvault" || "${OLD_ID}" == "com.edp.usbvault.app" ]]; then
    /bin/rm -rf "${OLD_APP}"
  fi
fi
if [[ -f "${OLD_RAW_ACCESS_APP}/Contents/Info.plist" ]] \
  && [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "${OLD_RAW_ACCESS_APP}/Contents/Info.plist" 2>/dev/null || true)" == "com.edp.usbvault.rawaccess" ]]; then
  /bin/rm -rf "${OLD_RAW_ACCESS_APP}"
fi
for RELOCATED_APP_DIR in /Applications/EDP\ USB\ Vault*.localized; do
  [[ -e "${RELOCATED_APP_DIR}" ]] || continue
  /bin/rm -rf "${RELOCATED_APP_DIR}"
done

exit 0
