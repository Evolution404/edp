@@ -2340,7 +2340,13 @@ static int ntfs_fuse_mknod(const char *path, mode_t mode, dev_t dev)
 static int ntfs_fuse_create_file(const char *path, mode_t mode,
 			    struct fuse_file_info *fi)
 {
-	return ntfs_fuse_mknod_common(path, mode, 0, fi);
+	/*
+	 * FUSE CREATE always creates a regular file. The macFUSE FSKit shim can
+	 * pass only the permission bits (for example 0644), whereas the legacy
+	 * kernel path includes S_IFREG in mode. Normalize the type here so the
+	 * shared mknod path never passes type == 0 to ntfs_create().
+	 */
+	return ntfs_fuse_mknod_common(path, S_IFREG | (mode & 07777), 0, fi);
 }
 
