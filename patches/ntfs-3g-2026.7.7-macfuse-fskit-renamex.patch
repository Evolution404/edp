 }
+
+#if defined(__APPLE__) || defined(__DARWIN__)
+#ifndef RENAME_SWAP
+#define RENAME_SWAP 0x00000002
+#endif
+#ifndef RENAME_EXCL
+#define RENAME_EXCL 0x00000004
+#endif
 
+static int ntfs_macfuse_renamex(const char *old_path, const char *new_path,
+				unsigned int flags)
+{
+	struct stat st;
+	int ret;
+
+	if (flags & RENAME_SWAP)
+		return -EOPNOTSUPP;
+	if (flags & ~RENAME_EXCL)
+		return -EINVAL;
+	if (flags & RENAME_EXCL) {
+		ret = ntfs_fuse_getattr(new_path, &st);
+		if (!ret)
+			return -EEXIST;
+		if (ret != -ENOENT)
+			return ret;
+	}
+	return ntfs_fuse_rename(old_path, new_path);
+}
+#endif
