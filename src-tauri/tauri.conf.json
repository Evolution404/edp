{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDPOpen",
  "version": "0.1.0",
  "identifier": "com.evolution404.edpopen",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EDPOpen",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": []
  }
}
